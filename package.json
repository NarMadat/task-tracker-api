{
  "name": "nestjs-devops-api",
  "version": "1.0.0",
  "description": "Production-ready Nest.js API configured for DevOps CI/CD pipelines with Mocha and JUnit reporter",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "mocha --config .mocharc.json 'src/**/*.spec.ts' 'test/**/*.e2e-spec.ts'",
    "test:unit": "mocha --config .mocharc.json 'src/**/*.spec.ts'",
    "test:e2e": "mocha --config .mocharc.json 'test/**/*.e2e-spec.ts'",
    "test:junit": "mocha --config .mocharc.json --reporter mocha-junit-reporter --reporter-options mochaFile=./test-results/junit.xml 'src/**/*.spec.ts' 'test/**/*.e2e-spec.ts'",
    "test:ci": "mocha --config .mocharc.ci.json 'src/**/*.spec.ts' 'test/**/*.e2e-spec.ts'",
    "test:coverage": "c8 --reporter=text --reporter=lcov mocha --config .mocharc.json 'src/**/*.spec.ts' 'test/**/*.e2e-spec.ts'"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@types/chai": "^4.3.16",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "c8": "^9.1.0",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
